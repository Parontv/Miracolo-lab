async function handleRequest(request) {
  const url = new URL(request.url);
  const path = url.pathname;

  if (request.method === "OPTIONS") {
    return new Response(null, {
      headers: {
        "access-control-allow-origin": "*",
        "access-control-allow-methods": "GET, OPTIONS",
        "access-control-allow-headers": "Content-Type"
      }
    });
  }

  if (path === "/" || path === "") {
    return htmlResponse();
  }

  if (path === "/health") {
    return jsonResponse({
      ok: true,
      bot: "Investimenti Bot",
      status: "online",
      timestamp: new Date().toISOString(),
      version: "1.0.0"
    });
  }

  if (path === "/news") {
    const feeds = await collectFeeds(NEWS_FEEDS);

    const items = deduplicate(
      feeds.flatMap(result => result.items)
    );

    const analyzed = analyzeItems(items);

    return jsonResponse({
      ok: true,
      type: "news",
      count: analyzed.length,
      feeds,
      items: analyzed.slice(0, 50)
    });
  }

  if (path === "/social") {
    const feeds = await collectFeeds(SOCIAL_FEEDS);

    const items = deduplicate(
      feeds.flatMap(result => result.items)
    );

    const analyzed = analyzeItems(items);

    return jsonResponse({
      ok: true,
      type: "social",
      count: analyzed.length,
      feeds,
      items: analyzed.slice(0, 50)
    });
  }

  if (path === "/scan") {
    const [newsFeeds, socialFeeds] =
      await Promise.all([
        collectFeeds(NEWS_FEEDS),
        collectFeeds(SOCIAL_FEEDS)
      ]);

    const news = analyzeItems(
      deduplicate(
        newsFeeds.flatMap(result => result.items)
      )
    );

    const social = analyzeItems(
      deduplicate(
        socialFeeds.flatMap(result => result.items)
      )
    );

    const all = analyzeItems(
      deduplicate([
        ...news,
        ...social
      ])
    );

    return jsonResponse({
      ok: true,
      type: "full_scan",
      timestamp: new Date().toISOString(),

      summary: {
        news: news.length,
        social: social.length,
        total: all.length
      },

      top_signals: all.slice(0, 20),

      news: news.slice(0, 30),

      social: social.slice(0, 30)
    });
  }

  return new Response(
    JSON.stringify({
      ok: false,
      error: "Endpoint non trovato",
      available: [
        "/",
        "/health",
        "/news",
        "/social",
        "/scan"
      ]
    }, null, 2),
    {
      status: 404,
      headers: {
        "content-type": "application/json; charset=UTF-8"
      }
    }
  );
}

export default {
  async fetch(request, env, ctx) {
    return handleRequest(request);
  }
};
