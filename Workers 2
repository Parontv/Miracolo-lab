function cleanText(text) {
  if (!text) return "";

  return text
    .replace(/<!\[CDATA\[/g, "")
    .replace(/\]\]>/g, "")
    .replace(/<[^>]*>/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, " ")
    .trim();
}

function getTag(block, tag) {
  const regex = new RegExp(
    `<${tag}(?:\\s[^>]*)?>([\\s\\S]*?)<\\/${tag}>`,
    "i"
  );

  const match = block.match(regex);

  return match ? cleanText(match[1]) : "";
}

function getLink(block) {
  let match = block.match(
    /<link[^>]*href=["']([^"']+)["'][^>]*\/?>/i
  );

  if (match) return match[1];

  match = block.match(
    /<link[^>]*>([\s\S]*?)<\/link>/i
  );

  return match ? cleanText(match[1]) : "";
}

function parseRSS(xml, source) {
  const results = [];

  const blocks =
    xml.match(/<item[\s\S]*?<\/item>/gi) ||
    xml.match(/<entry[\s\S]*?<\/entry>/gi) ||
    [];

  for (const block of blocks) {
    const title =
      getTag(block, "title") ||
      getTag(block, "name");

    const description =
      getTag(block, "description") ||
      getTag(block, "summary") ||
      getTag(block, "content");

    const link = getLink(block);

    const published =
      getTag(block, "pubDate") ||
      getTag(block, "published") ||
      getTag(block, "updated");

    if (!title) continue;

    results.push({
      source,
      title,
      description,
      link,
      published
    });
  }

  return results;
}

async function fetchFeed(feed) {
  try {
    const response = await fetch(feed.url, {
      headers: {
        "User-Agent": "InvestimentiBot/1.0"
      }
    });

    if (!response.ok) {
      return {
        source: feed.name,
        error: `HTTP ${response.status}`,
        items: []
      };
    }

    const text = await response.text();

    return {
      source: feed.name,
      error: null,
      items: parseRSS(text, feed.name)
    };
  } catch (error) {
    return {
      source: feed.name,
      error: error.message,
      items: []
    };
  }
}

async function collectFeeds(feeds) {
  const responses = await Promise.all(
    feeds.map(feed => fetchFeed(feed))
  );

  return responses;
}

function deduplicate(items) {
  const seen = new Set();
  const output = [];

  for (const item of items) {
    const key =
      item.link ||
      `${item.source}-${item.title}`;

    if (seen.has(key)) continue;

    seen.add(key);
    output.push(item);
  }

  return output;
}

function scoreItem(item) {
  const text = (
    `${item.title} ${item.description}`
  ).toLowerCase();

  let score = 0;

  const importantWords = [
    "fed",
    "bce",
    "inflazione",
    "tassi",
    "recessione",
    "earnings",
    "utile",
    "ricavi",
    "guidance",
    "acquisizione",
    "fusione",
    "profit",
    "bitcoin",
    "ethereum",
    "nasdaq",
    "s&p",
    "wall street",
    "borsa",
    "crash",
    "rally"
  ];

  for (const word of importantWords) {
    if (text.includes(word)) {
      score += 1;
    }
  }

  return score;
}

function analyzeItems(items) {
  return items
    .map(item => ({
      ...item,
      score: scoreItem(item)
    }))
    .sort((a, b) => b.score - a.score);
}

function jsonResponse(data) {
  return new Response(
    JSON.stringify(data, null, 2),
    {
      headers: {
        "content-type": "application/json; charset=UTF-8",
        "access-control-allow-origin": "*"
      }
    }
  );
}

